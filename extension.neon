parameters:
    drupalRules:
        # Toggle individual rules. Useful while gradually adopting the package.
        noServiceLocatorInDIClass: true
        hookImplementationSignature: true
        noDeprecatedEntityApi: true
        noEntityQueryWithoutAccessCheck: true
        properPermissionConstants: true

        # Permission machine names that are allowed to stay as string literals.
        # A few stable core permissions are rarely renamed and not worth
        # promoting to a constant.
        allowedPermissionStrings:
            - access content

        # Base classes that imply DI is wired up. Calling \Drupal::service()
        # from inside a subclass of one of these is considered a code smell.
        diBaseClasses:
            - Drupal\Core\Controller\ControllerBase
            - Drupal\Core\Form\FormBase
            - Drupal\Core\Form\ConfigFormBase
            - Drupal\Core\Block\BlockBase
            - Drupal\Core\Condition\ConditionPluginBase
            - Drupal\Core\Field\FormatterBase
            - Drupal\Core\Field\WidgetBase
            - Drupal\Core\Plugin\PluginBase

        # Static-call locator method names on \Drupal that are forbidden inside DI-aware classes.
        forbiddenLocatorMethods:
            - service
            - config
            - entityTypeManager
            - entityQuery
            - entityFieldManager
            - currentUser
            - logger
            - state
            - cache
            - database
            - moduleHandler
            - messenger
            - requestStack
            - languageManager

services:
    -
        class: MykolaPodpriatov\PhpStanDrupalRules\Rules\NoServiceLocatorInDIClassRule
        arguments:
            diBaseClasses: %drupalRules.diBaseClasses%
            forbiddenLocatorMethods: %drupalRules.forbiddenLocatorMethods%
            enabled: %drupalRules.noServiceLocatorInDIClass%
        tags:
            - phpstan.rules.rule

    -
        class: MykolaPodpriatov\PhpStanDrupalRules\Rules\HookImplementationSignatureRule
        arguments:
            enabled: %drupalRules.hookImplementationSignature%
        tags:
            - phpstan.rules.rule

    -
        class: MykolaPodpriatov\PhpStanDrupalRules\Rules\NoDeprecatedEntityApiRule
        arguments:
            enabled: %drupalRules.noDeprecatedEntityApi%
        tags:
            - phpstan.rules.rule

    -
        class: MykolaPodpriatov\PhpStanDrupalRules\Rules\NoEntityQueryWithoutAccessCheckRule
        arguments:
            enabled: %drupalRules.noEntityQueryWithoutAccessCheck%
        tags:
            - phpstan.rules.rule

    -
        class: MykolaPodpriatov\PhpStanDrupalRules\Rules\ProperPermissionConstantsRule
        arguments:
            allowedPermissions: %drupalRules.allowedPermissionStrings%
            enabled: %drupalRules.properPermissionConstants%
        tags:
            - phpstan.rules.rule

    # Supplies parent links (the `chainParent` attribute) the entity-query rule
    # needs to find the tail of a fluent call. PHPStan 2.x stopped connecting
    # nodes by default, so we register our own visitor on the rich parser.
    -
        class: MykolaPodpriatov\PhpStanDrupalRules\NodeVisitor\ChainParentVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
