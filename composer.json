{
    "name": "mykolapodpriatov/phpstan-drupal-rules",
    "description": "Opinionated PHPStan rules for Drupal 10.3+/11 codebases — DI hygiene, hook signature checks, deprecated API detection and entity query access checks.",
    "type": "phpstan-extension",
    "keywords": [
        "drupal",
        "phpstan",
        "static-analysis",
        "dependency-injection",
        "drupal-10",
        "drupal-11"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mykola Podpriatov",
            "email": "nsplotos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "phpstan/phpstan": "^2.0",
        "mglaman/phpstan-drupal": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MykolaPodpriatov\\PhpStanDrupalRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MykolaPodpriatov\\PhpStanDrupalRules\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Rules/data/"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse --memory-limit=512M",
        "ci": [
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
